# docker compose 使用的环境变量样例
# 用法：复制为 .env（.env 已在 .gitignore 中，不会入库），填入真实值后执行 docker compose up -d
#
#   cp .env.example .env
#
# 注意：变量名必须与 backend/src/main/resources/application.yml 中的 ${...} 占位符完全一致，
#       改名前先 grep 一下占位符，否则容器启动会报 Could not resolve placeholder。

# 通义千问（OpenAI 兼容模式）API Key
QWEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 以下为 docker-compose.yml 中已硬编码的默认值，如需外部覆盖可取消注释
# MYSQL_ROOT_PASSWORD=changeme
# REDIS_PASSWORD=changeme
